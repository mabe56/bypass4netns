# GitLab Configuration for bypass4netns packaging
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Your GitLab instance URL
GITLAB_URL=https://gitlab.com

# Your project ID (found in Project Settings → General)
GITLAB_PROJECT_ID=

# Your Personal Access Token (create at /user_settings/personal_access_tokens)
# Required scope: api
GITLAB_TOKEN=

# Package version (optional, defaults to git tag)
#VERSION=1.0.0
